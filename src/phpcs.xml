<?xml version="1.0"?>
<ruleset name="Broadcast Notification Service">
    <description>Coding standard for the project</description>

    <file>app</file>

    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg value="np"/>

    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
    </rule>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/OpenApi/swagger_constants.php</exclude-pattern>
</ruleset>
